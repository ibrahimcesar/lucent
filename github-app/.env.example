# GitHub App Configuration
# Get these values from your GitHub App settings page

# The App ID from your GitHub App settings
GITHUB_APP_ID=

# The webhook secret you configured for your GitHub App
GITHUB_WEBHOOK_SECRET=

# Path to the private key file (.pem) downloaded from GitHub App settings
GITHUB_PRIVATE_KEY_PATH=./private-key.pem

# Or paste the private key directly (replace newlines with \n)
# GITHUB_PRIVATE_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development

# Lucent Configuration
# Path to lucent binary (leave empty to use PATH)
LUCENT_PATH=

# Optional: Smee.io webhook proxy URL for local development
# Create one at https://smee.io/new
WEBHOOK_PROXY_URL=
